# .gitignore — files that should never be committed to version control

# Dependencies
/node_modules

# Next.js build output
/.next/
/out/

# Environment variables (contains secrets — never commit real .env files)
.env
.env*.local

# Prisma generated client (regenerated automatically on install)
/node_modules/.prisma

# Editor/OS junk files
.DS_Store
*.pem
npm-debug.log*
